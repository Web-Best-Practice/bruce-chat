{
    "name": "web-best-practice/bruce-chat",
    "description": "Laravel bridge package for the Bruce AI chat widget, capabilities API, and enquiry tools.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Web Best Practice",
            "email": "hello@webbestpractice.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "WebBestPractice\\BruceChat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebBestPractice\\BruceChat\\BruceChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
